{
  "manifest_version": 3,
  "name": "ResearchMate",
  "version": "2.0.8",
  "description": "AI-powered research companion for your browser",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open ResearchMate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://research-mate-website.vercel.app/*"],
      "js": ["src/content/authSync.ts"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Open ResearchMate"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "oauth2": {
    "client_id": "63045817614-6sn8ojehhraqfvd4lhk35f7jvfutfg5f.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "key": ""
}