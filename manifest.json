{
  "manifest_version": 3,
  "name": "ResearchMate",
  "version": "0.1.2",
  "description": "Save and organize research highlights with tags, notes, and citations",
  "action": {
    "default_title": "ResearchMate",
    "default_popup": "scr/UI/popup/popup.html",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "scr/background/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scr/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["scr/lib/pdf.worker.min.js", "scr/lib/pdf.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
