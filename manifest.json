{
  "manifest_version": 3,
  "name": "ResearchMate",
  "version": "1.0.1",
  "description": "Highlight & save research snippets with cloud sync",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "scr/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "scr/UI/popup/popup.html",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scr/content/content.js"],
      "run_at": "document_end"
    }
  ]
}
