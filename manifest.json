{
  "manifest_version": 3,
  "name": "ResearchMate",
  "version": "1.0.8",
  "description": "Highlight & save research snippets with cloud sync",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://*.supabase.co https://jxevjkzojfbywxvtcwtl.supabase.co wss://*.supabase.co"
  },
  "background": {
    "service_worker": "scr/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "scr/UI/popup/popup.html",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scr/content/content.js"],
      "run_at": "document_end"
    }
  ]
}
